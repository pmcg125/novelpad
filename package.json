{
  "name": "novelpad",
  "version": "0.0.1",
  "private": true,
  "description": "NovelPad — 作家的 VS Code：Markdown 创作、设定即代码、Novel Copilot、知识图谱",
  "type": "module",
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "build": "pnpm -r --filter @novelpad/core --filter @novelpad/theme --filter @novelpad/schema --filter @novelpad/cli --filter novelpad run build",
    "test": "pnpm -r --filter @novelpad/core --filter @novelpad/cli --filter novelpad run test",
    "typecheck": "pnpm -r --filter @novelpad/core --filter @novelpad/cli --filter novelpad run typecheck",
    "clean": "pnpm -r --filter @novelpad/core --filter @novelpad/cli --filter novelpad run clean"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vscode/test-electron": "^3.1.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
