{
  "name": "novelpad",
  "displayName": "NovelPad",
  "description": "作家的 VS Code —— Markdown 小说创作、设定即代码、Novel Copilot、知识图谱",
  "version": "0.0.1",
  "publisher": "novelpad",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "keywords": [
    "novel",
    "writing",
    "fiction",
    "markdown",
    "worldbuilding"
  ],
  "icon": "assets/icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.novelpad",
    "workspaceContains:chapters"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "novelpad",
          "title": "NovelPad",
          "icon": "assets/activity.svg"
        }
      ]
    },
    "views": {
      "novelpad": [
        {
          "id": "novelpad.chapters",
          "name": "章节",
          "icon": "assets/chapters.svg"
        },
        {
          "id": "novelpad.entities",
          "name": "设定",
          "icon": "assets/lore.svg"
        },
        {
          "id": "novelpad.graph",
          "name": "图谱",
          "icon": "assets/graph.svg"
        },
        {
          "id": "novelpad.annotations",
          "name": "批注",
          "icon": "assets/annotations.svg"
        },
        {
          "id": "novelpad.branches",
          "name": "支线",
          "icon": "assets/branches.svg",
          "contextualTitle": "支线（分工合写）"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "novelpad.chapters",
        "contents": "还没有打开作品。\n[新建作品](command:novelpad.initProject)\n[打开作品文件夹](command:vscode.openFolder)\n\n用 Markdown 写作：章节、角色、世界观都是文件。"
      },
      {
        "view": "novelpad.graph",
        "contents": "图谱会从角色卡的 relations、章节的 characters / locations 和伏笔声明自动生成。\n[打开关系云图](command:novelpad.graph.open)\n[打开剧情发展链](command:novelpad.graph.chain)"
      }
    ],
    "commands": [
      {
        "command": "novelpad.initProject",
        "title": "NovelPad: 新建作品",
        "icon": "$(add)"
      },
      {
        "command": "novelpad.newChapter",
        "title": "NovelPad: 新建章节",
        "icon": "$(add)"
      },
      {
        "command": "novelpad.newCharacter",
        "title": "Novelpad: 新建角色",
        "icon": "$(add)"
      },
      {
        "command": "novelpad.openChapter",
        "title": "NovelPad: 打开章节"
      },
      {
        "command": "novelpad.openEntity",
        "title": "NovelPad: 打开设定"
      },
      {
        "command": "novelpad.exportTxt",
        "title": "NovelPad: 导出 TXT"
      },
      {
        "command": "novelpad.exportDocx",
        "title": "NovelPad: 导出 Word"
      },
      {
        "command": "novelpad.check",
        "title": "NovelPad: 检查设定一致性"
      },
      {
        "command": "novelpad.stats",
        "title": "NovelPad: 字数统计"
      },
      {
        "command": "novelpad.refresh",
        "title": "NovelPad: 刷新",
        "icon": "$(refresh)"
      },
      {
        "command": "novelpad.copilot.continue",
        "title": "NovelPad: Copilot 续写（带要求）",
        "icon": "$(sparkle)"
      },
      {
        "command": "novelpad.copilot.continueDirect",
        "title": "NovelPad: Copilot 续写"
      },
      {
        "command": "novelpad.copilot.editSelection",
        "title": "NovelPad: Copilot 改写选中文字"
      },
      {
        "command": "novelpad.copilot.ask",
        "title": "NovelPad: Copilot 问问设定",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "novelpad.copilot.setApiKey",
        "title": "NovelPad: Copilot 设置 API Key"
      },
      {
        "command": "novelpad.copilot.testConnection",
        "title": "NovelPad: Copilot 测试连接"
      },
      {
        "command": "novelpad.copilot.edit",
        "title": "NovelPad: Copilot 改写（内部）"
      },
      {
        "command": "novelpad.copilot.draftCharacter",
        "title": "NovelPad: Copilot 生成角色卡草稿"
      },
      {
        "command": "novelpad.copilot.showLastReasoning",
        "title": "NovelPad: Copilot 查看上次思考过程",
        "icon": "$(lightbulb)"
      },
      {
        "command": "novelpad.rag.rebuild",
        "title": "NovelPad: 建立向量索引（RAG）",
        "icon": "$(database)"
      },
      {
        "command": "novelpad.rag.search",
        "title": "NovelPad: 检索相似场景与设定"
      },
      {
        "command": "novelpad.decision.review",
        "title": "NovelPad: 决策模型审查本章（OOC / 视角 / 设定矛盾）",
        "icon": "$(checklist)"
      },
      {
        "command": "novelpad.decision.clear",
        "title": "NovelPad: 清除审查结果"
      },
      {
        "command": "novelpad.decision.resolve",
        "title": "NovelPad: 决策模型裁决选中冲突"
      },
      {
        "command": "novelpad.decision.test",
        "title": "NovelPad: 决策模型连接测试"
      },
      {
        "command": "novelpad._test.setApiKey",
        "title": "NovelPad: (internal) set api key"
      },
      {
        "command": "novelpad._test.continueAtCursor",
        "title": "NovelPad: (internal) continue at cursor"
      },
      {
        "command": "novelpad.graph.open",
        "title": "NovelPad: 打开关系云图",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "novelpad.graph.chain",
        "title": "NovelPad: 打开剧情发展链"
      },
      {
        "command": "novelpad.focusMode",
        "title": "NovelPad: 专注模式",
        "category": "NovelPad"
      },
      {
        "command": "novelpad.timeline",
        "title": "NovelPad: 时间线（改稿历史）",
        "category": "NovelPad",
        "icon": "$(history)"
      },
      {
        "command": "novelpad.version.milestone",
        "title": "NovelPad: 存一版（里程碑）",
        "category": "NovelPad",
        "icon": "$(bookmark)"
      },
      {
        "command": "novelpad.version.saveNow",
        "title": "NovelPad: 立即存档",
        "category": "NovelPad"
      },
      {
        "command": "novelpad.annotations.addComment",
        "title": "加批注",
        "category": "NovelPad",
        "icon": "$(comment-discussion)",
        "description": "为选中的文字写一条批注。"
      },
      {
        "command": "novelpad.annotations.addSuggestion",
        "title": "提修改建议",
        "category": "NovelPad",
        "icon": "$(lightbulb)",
        "description": "针对选中的文字提一个具体改法，可在编辑器里一键接受。"
      },
      {
        "command": "novelpad.annotations.refresh",
        "title": "刷新批注",
        "category": "NovelPad",
        "icon": "$(refresh)",
        "description": "重新读取 .novelpad/annotations.jsonl。"
      },
      {
        "command": "novelpad.annotations.resolve",
        "title": "标记已解决",
        "category": "NovelPad",
        "icon": "$(check)",
        "description": "把这条批注标记为已解决。"
      },
      {
        "command": "novelpad.annotations.reopen",
        "title": "重新打开",
        "category": "NovelPad",
        "icon": "$(debug-restart)",
        "description": "把已解决的批注改回待处理。"
      },
      {
        "command": "novelpad.annotations.remove",
        "title": "删除批注",
        "category": "NovelPad",
        "icon": "$(trash)",
        "description": "删掉这条批注（不可撤销）。"
      },
      {
        "command": "novelpad.annotations.accept",
        "title": "接受建议",
        "category": "NovelPad",
        "icon": "$(check)",
        "description": "用建议的内容替换原文。原文若已被改动会先询问。"
      },
      {
        "command": "novelpad.annotations.reject",
        "title": "拒绝建议",
        "category": "NovelPad",
        "icon": "$(close)",
        "description": "拒绝这条修改建议，原文不动。"
      },
      {
        "command": "novelpad.annotations.reply",
        "title": "回复",
        "category": "NovelPad",
        "icon": "$(reply)",
        "description": "在这条批注下追一条回复。"
      },
      {
        "command": "novelpad.annotations.goto",
        "title": "跳转到批注",
        "category": "NovelPad",
        "icon": "$(go-to-file)",
        "description": "跳到批注所在的原文位置。"
      },
      {
        "command": "novelpad.branch.new",
        "title": "NovelPad: 新建支线（分工合写）",
        "category": "NovelPad",
        "icon": "$(git-branch)"
      },
      {
        "command": "novelpad.branch.open",
        "title": "NovelPad: 并回主稿",
        "category": "NovelPad",
        "icon": "$(git-merge)"
      },
      {
        "command": "novelpad.branch.openWorktree",
        "title": "NovelPad: 在新窗口打开支线",
        "category": "NovelPad",
        "icon": "$(empty-window)"
      },
      {
        "command": "novelpad.branch.remove",
        "title": "NovelPad: 删除支线",
        "category": "NovelPad",
        "icon": "$(trash)"
      },
      {
        "command": "novelpad.branch.refresh",
        "title": "NovelPad: 刷新支线列表",
        "category": "NovelPad",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "novelpad.newChapter",
          "when": "view == novelpad.chapters",
          "group": "navigation@1"
        },
        {
          "command": "novelpad.refresh",
          "when": "view == novelpad.chapters || view == novelpad.entities",
          "group": "navigation@2"
        },
        {
          "command": "novelpad.newCharacter",
          "when": "view == novelpad.entities",
          "group": "navigation@1"
        },
        {
          "command": "novelpad.exportTxt",
          "when": "view == novelpad.chapters",
          "group": "1_export@1"
        },
        {
          "command": "novelpad.exportDocx",
          "when": "view == novelpad.chapters",
          "group": "1_export@2"
        },
        {
          "command": "novelpad.graph.open",
          "when": "view == novelpad.chapters || view == novelpad.entities",
          "group": "navigation@3"
        },
        {
          "command": "novelpad.graph.open",
          "when": "view == novelpad.graph",
          "group": "navigation@1"
        },
        {
          "command": "novelpad.graph.chain",
          "when": "view == novelpad.graph",
          "group": "navigation@2"
        },
        {
          "command": "novelpad.timeline",
          "when": "view == novelpad.chapters || view == novelpad.entities",
          "group": "navigation@4"
        },
        {
          "command": "novelpad.version.milestone",
          "when": "view == novelpad.chapters",
          "group": "1_export@3"
        },
        {
          "command": "novelpad.annotations.addComment",
          "when": "view == novelpad.annotations",
          "group": "navigation@1"
        },
        {
          "command": "novelpad.annotations.refresh",
          "when": "view == novelpad.annotations",
          "group": "navigation@2"
        },
        {
          "command": "novelpad.branch.new",
          "when": "view == novelpad.branches",
          "group": "navigation@1"
        },
        {
          "command": "novelpad.branch.refresh",
          "when": "view == novelpad.branches",
          "group": "navigation@2"
        },
        {
          "command": "novelpad.branch.new",
          "when": "view == novelpad.chapters",
          "group": "2_branch@1"
        },
        {
          "command": "novelpad.branch.open",
          "when": "view == novelpad.chapters",
          "group": "2_branch@2"
        }
      ],
      "view/item/context": [
        {
          "command": "novelpad.newChapter",
          "when": "view == novelpad.chapters",
          "group": "inline"
        },
        {
          "command": "novelpad.annotations.goto",
          "when": "viewItem == annotation.open || viewItem == annotation.open.suggestion || viewItem == annotation.closed",
          "group": "inline@1"
        },
        {
          "command": "novelpad.annotations.accept",
          "when": "viewItem == annotation.open.suggestion",
          "group": "inline@2"
        },
        {
          "command": "novelpad.annotations.reject",
          "when": "viewItem == annotation.open.suggestion",
          "group": "inline@3"
        },
        {
          "command": "novelpad.annotations.resolve",
          "when": "viewItem == annotation.open || viewItem == annotation.open.suggestion",
          "group": "1_actions@1"
        },
        {
          "command": "novelpad.annotations.reopen",
          "when": "viewItem == annotation.closed",
          "group": "1_actions@1"
        },
        {
          "command": "novelpad.annotations.reply",
          "when": "viewItem == annotation.open || viewItem == annotation.open.suggestion || viewItem == annotation.closed",
          "group": "1_actions@2"
        },
        {
          "command": "novelpad.annotations.remove",
          "when": "viewItem == annotation.open || viewItem == annotation.open.suggestion || viewItem == annotation.closed",
          "group": "9_danger@1"
        },
        {
          "command": "novelpad.branch.open",
          "when": "view == novelpad.branches && viewItem == novelpadBranch",
          "group": "inline@1"
        },
        {
          "command": "novelpad.branch.openWorktree",
          "when": "view == novelpad.branches && viewItem == novelpadBranch",
          "group": "inline@2"
        },
        {
          "command": "novelpad.branch.remove",
          "when": "view == novelpad.branches && viewItem == novelpadBranch",
          "group": "inline@3"
        }
      ],
      "commandPalette": [
        {
          "command": "novelpad.openChapter",
          "when": "false"
        },
        {
          "command": "novelpad.openEntity",
          "when": "false"
        },
        {
          "command": "novelpad.copilot.edit",
          "when": "false"
        },
        {
          "command": "novelpad._test.setApiKey",
          "when": "false"
        },
        {
          "command": "novelpad._test.continueAtCursor",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "novelpad.annotations.addComment",
          "when": "editorLangId == markdown && editorHasSelection",
          "group": "novelpad@1"
        },
        {
          "command": "novelpad.annotations.addSuggestion",
          "when": "editorLangId == markdown && editorHasSelection",
          "group": "novelpad@2"
        }
      ]
    },
    "configurationDefaults": {
      "editor.fontFamily": "'LXGW WenKai Screen', 'LXGW WenKai', 'Kaiti SC', 'STKaiti', 'KaiTi', serif",
      "editor.fontSize": 19,
      "editor.lineHeight": 2,
      "editor.letterSpacing": 0.4,
      "editor.lineNumbers": "off",
      "editor.minimap.enabled": false,
      "editor.folding": false,
      "editor.renderLineHighlight": "none",
      "editor.glyphMargin": false,
      "editor.cursorSurroundingLines": 6,
      "editor.wordWrap": "on",
      "editor.wrappingIndent": "none",
      "editor.quickSuggestions": {
        "other": "off",
        "comments": "off",
        "strings": "off"
      },
      "editor.occurrencesHighlight": "off",
      "editor.selectionHighlight": false,
      "editor.renderWhitespace": "none",
      "editor.scrollbar.verticalScrollbarSize": 10,
      "editor.scrollbar.horizontalScrollbarSize": 10,
      "workbench.startupEditor": "none",
      "workbench.editor.showTabs": "single",
      "workbench.editor.tabSizing": "shrink",
      "workbench.tree.indent": 14,
      "workbench.list.smoothScrolling": true,
      "window.commandCenter": false,
      "window.title": "${activeEditorShort} · NovelPad",
      "breadcrumbs.enabled": false,
      "explorer.compactFolders": false,
      "files.eol": "\n",
      "files.trimTrailingWhitespace": false,
      "files.insertFinalNewline": true,
      "zenMode.hideActivityBar": true,
      "zenMode.hideStatusBar": true,
      "zenMode.showTabs": "none",
      "zenMode.centerLayout": true,
      "zenMode.fullScreen": false,
      "zenMode.silentNotifications": true,
      "zenMode.restore": false,
      "markdown.preview.fontFamily": "'LXGW WenKai Screen', 'LXGW WenKai', 'Kaiti SC', 'STKaiti', 'KaiTi', serif",
      "markdown.preview.fontSize": 19,
      "markdown.preview.lineHeight": 2,
      "markdown.preview.breaks": true,
      "[markdown]": {
        "editor.quickSuggestions": {
          "other": "off",
          "comments": "off",
          "strings": "off"
        },
        "editor.wordWrap": "on",
        "editor.tabSize": 2,
        "editor.defaultFormatter": null
      }
    },
    "configuration": {
      "title": "NovelPad",
      "properties": {
        "novelpad.exportProfile": {
          "type": "string",
          "enum": [
            "default",
            "submission",
            "print"
          ],
          "default": "default",
          "description": "默认导出 profile（可被作品 .novelpad/config.json 覆盖）。"
        },
        "novelpad.lintOnSave": {
          "type": "boolean",
          "default": true,
          "description": "保存章节时运行 lint 并在问题面板显示。"
        },
        "novelpad.showWordCount": {
          "type": "boolean",
          "default": true,
          "description": "在状态栏显示当前章节字数与全书字数。"
        },
        "novelpad.typeset.headingBand": {
          "type": "boolean",
          "default": true,
          "description": "给章节标题行加一层暖色底纹，让「新的一章开始了」在长文中一眼可见。只加底色，不改字号（改字号会让光标定位偏移）。高对比度主题下自动不启用。"
        },
        "novelpad.typeset.sceneBreak": {
          "type": "boolean",
          "default": true,
          "description": "把单独成行的 `***` / `---` / `___` 显示成空白，看起来像场景切换的留白。源码里的星号仍在，可点可改可复制。"
        },
        "novelpad.typeset.dimComments": {
          "type": "boolean",
          "default": true,
          "description": "把 `<!-- 备注 -->` 显示成淡色，一眼区分「这是草稿批注，不是正文」。"
        },
        "novelpad.typeset.wikiLinks": {
          "type": "boolean",
          "default": true,
          "description": "给双链 `[[角色]]` 加链接色与虚线下划线。只着色，不改内容。"
        },
        "novelpad.typeset.firstLineIndent": {
          "type": "boolean",
          "default": false,
          "description": "段首缩进 2em。**默认关闭**：它靠 CSS 改变文字实际位置，而编辑器的光标定位按字符宽度累加计算，不知道这段缩进——开启后每段首行的光标、选区、点击定位都会左偏 2em。段首缩进建议留给导出（导出本就带缩进）。"
        },
        "novelpad.copilot.enabled": {
          "type": "boolean",
          "default": true,
          "description": "启用 Novel Copilot（续写 / 润色 / 问答）。"
        },
        "novelpad.copilot.showReasoning": {
          "type": "boolean",
          "default": true,
          "description": "推理模型的思考过程（以小说家口吻写的批注）：续写完成后状态栏可点击查看，改写与问答面板折叠显示。"
        },
        "novelpad.copilot.provider": {
          "type": "string",
          "enum": [
            "custom",
            "deepseek",
            "zhipu",
            "dashscope",
            "ollama",
            "openai"
          ],
          "enumDescriptions": [
            "自定义 / 本地反代（默认 127.0.0.1:8788/v1）",
            "DeepSeek 官方",
            "智谱 GLM",
            "通义千问 DashScope 兼容模式",
            "Ollama 本地（无需 Key）",
            "OpenAI 官方"
          ],
          "default": "custom",
          "description": "服务商预设（决定默认 baseUrl，可被 novelpad.copilot.baseUrl 覆盖）。"
        },
        "novelpad.copilot.baseUrl": {
          "type": "string",
          "default": "",
          "description": "OpenAI 兼容接口地址。留空则使用服务商预设。"
        },
        "novelpad.copilot.model": {
          "type": "string",
          "default": "deepseek-v4.1-flash",
          "description": "续写用模型。"
        },
        "novelpad.copilot.editModel": {
          "type": "string",
          "default": "",
          "description": "润色 / 扩写 / 问答用模型。留空则与续写相同。"
        },
        "novelpad.copilot.timeoutMs": {
          "type": "number",
          "default": 90000,
          "description": "请求超时（毫秒）。推理模型建议 ≥ 60000。"
        },
        "novelpad.rag.enabled": {
          "type": "boolean",
          "default": true,
          "description": "续写前检索相似场景与相关设定注入上下文。"
        },
        "novelpad.rag.apiKey": {
          "type": "string",
          "default": "",
          "description": "阿里云 DashScope API Key（Embedding / Rerank / 决策模型共用）。"
        },
        "novelpad.rag.workspaceId": {
          "type": "string",
          "default": "",
          "description": "百炼业务空间 ID（Rerank 与决策模型需要）。"
        },
        "novelpad.rag.embeddingModel": {
          "type": "string",
          "default": "qwen3.7-text-embedding-flash",
          "description": "向量模型。"
        },
        "novelpad.rag.rerank": {
          "type": "boolean",
          "default": true,
          "description": "检索后用 qwen3.7-text-rerank 精排。"
        },
        "novelpad.rag.rerankModel": {
          "type": "string",
          "default": "qwen3.7-text-rerank",
          "description": "精排模型。"
        },
        "novelpad.rag.topK": {
          "type": "number",
          "default": 5,
          "description": "检索返回段落数。"
        },
        "novelpad.decision.enabled": {
          "type": "boolean",
          "default": true,
          "description": "续写前用决策模型预判人物情绪 / 节奏 / 位置一致性。"
        },
        "novelpad.decision.workspaceId": {
          "type": "string",
          "default": "",
          "description": "百炼业务空间 ID。"
        },
        "novelpad.decision.model": {
          "type": "string",
          "enum": [
            "decision-model",
            "decision-model-preview"
          ],
          "default": "decision-model",
          "description": "决策模型。"
        }
      }
    },
    "keybindings": [
      {
        "command": "novelpad.copilot.continueDirect",
        "key": "alt+\\",
        "mac": "alt+\\",
        "when": "editorLangId == markdown && editorTextFocus"
      },
      {
        "command": "novelpad.copilot.continue",
        "key": "alt+shift+\\",
        "mac": "alt+shift+\\",
        "when": "editorLangId == markdown && editorTextFocus"
      },
      {
        "command": "novelpad.focusMode",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f",
        "when": "editorTextFocus"
      },
      {
        "command": "novelpad.annotations.addComment",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorLangId == markdown && editorTextFocus && editorHasSelection"
      },
      {
        "command": "novelpad.annotations.accept",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "editorLangId == markdown && editorTextFocus"
      },
      {
        "command": "novelpad.branch.open",
        "key": "alt+shift+m",
        "when": "editorLangId == markdown"
      }
    ],
    "markdown.previewStyles": [
      "./media/markdown-preview.css"
    ],
    "themes": [
      {
        "label": "宣纸 · NovelPad Paper",
        "uiTheme": "vs",
        "path": "./themes/novelpad-paper-color-theme.json"
      },
      {
        "label": "夜墨 · NovelPad Ink",
        "uiTheme": "vs-dark",
        "path": "./themes/novelpad-ink-color-theme.json"
      }
    ],
    "yaml.schemas": {
      "./schemas/character-v1.json": [
        "characters/*.yaml",
        "characters/*.yml"
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": ".novelpad/config.json",
        "url": "./schemas/project-config.schema.json"
      }
    ]
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "watch": "node ./scripts/build.mjs --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "package": "vsce package --no-dependencies",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@novelpad/core": "workspace:*",
    "marked": "^18.3.0"
  },
  "devDependencies": {
    "@types/marked": "^6.0.0",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^2.26.0",
    "esbuild": "^0.24.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
