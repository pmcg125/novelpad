{
  "name": "novelpad",
  "displayName": "NovelPad",
  "description": "作家的 VS Code —— Markdown 小说创作、设定即代码、Novel Copilot、知识图谱",
  "version": "0.0.1",
  "publisher": "novelpad",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "keywords": [
    "novel",
    "writing",
    "fiction",
    "markdown",
    "worldbuilding"
  ],
  "icon": "assets/icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.novelpad",
    "workspaceContains:chapters"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "novelpad",
          "title": "NovelPad",
          "icon": "assets/activity.svg"
        }
      ]
    },
    "views": {
      "novelpad": [
        {
          "id": "novelpad.chapters",
          "name": "章节",
          "icon": "assets/chapters.svg"
        },
        {
          "id": "novelpad.entities",
          "name": "设定",
          "icon": "assets/lore.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "novelpad.chapters",
        "contents": "还没有打开作品。\n[新建作品](command:novelpad.initProject)\n[打开作品文件夹](command:vscode.openFolder)\n\n用 Markdown 写作：章节、角色、世界观都是文件。"
      }
    ],
    "commands": [
      {
        "command": "novelpad.initProject",
        "title": "NovelPad: 新建作品",
        "icon": "$(add)"
      },
      {
        "command": "novelpad.newChapter",
        "title": "NovelPad: 新建章节",
        "icon": "$(add)"
      },
      {
        "command": "novelpad.newCharacter",
        "title": "Novelpad: 新建角色",
        "icon": "$(add)"
      },
      {
        "command": "novelpad.openChapter",
        "title": "NovelPad: 打开章节"
      },
      {
        "command": "novelpad.openEntity",
        "title": "NovelPad: 打开设定"
      },
      {
        "command": "novelpad.exportTxt",
        "title": "NovelPad: 导出 TXT"
      },
      {
        "command": "novelpad.exportDocx",
        "title": "NovelPad: 导出 Word"
      },
      {
        "command": "novelpad.check",
        "title": "NovelPad: 检查设定一致性"
      },
      {
        "command": "novelpad.stats",
        "title": "NovelPad: 字数统计"
      },
      {
        "command": "novelpad.refresh",
        "title": "NovelPad: 刷新",
        "icon": "$(refresh)"
      },
      {
        "command": "novelpad.copilot.continue",
        "title": "NovelPad: Copilot 续写（带要求）",
        "icon": "$(sparkle)"
      },
      {
        "command": "novelpad.copilot.continueDirect",
        "title": "NovelPad: Copilot 续写"
      },
      {
        "command": "novelpad.copilot.editSelection",
        "title": "NovelPad: Copilot 改写选中文字"
      },
      {
        "command": "novelpad.copilot.ask",
        "title": "NovelPad: Copilot 问问设定",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "novelpad.copilot.setApiKey",
        "title": "NovelPad: Copilot 设置 API Key"
      },
      {
        "command": "novelpad.copilot.testConnection",
        "title": "NovelPad: Copilot 测试连接"
      },
      {
        "command": "novelpad.copilot.edit",
        "title": "NovelPad: Copilot 改写（内部）"
      },
      {
        "command": "novelpad.copilot.draftCharacter",
        "title": "NovelPad: Copilot 生成角色卡草稿"
      },
      {
        "command": "novelpad.copilot.showLastReasoning",
        "title": "NovelPad: Copilot 查看上次思考过程",
        "icon": "$(lightbulb)"
      },
      {
        "command": "novelpad._test.setApiKey",
        "title": "NovelPad: (internal) set api key"
      },
      {
        "command": "novelpad._test.continueAtCursor",
        "title": "NovelPad: (internal) continue at cursor"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "novelpad.newChapter",
          "when": "view == novelpad.chapters",
          "group": "navigation@1"
        },
        {
          "command": "novelpad.refresh",
          "when": "view == novelpad.chapters || view == novelpad.entities",
          "group": "navigation@2"
        },
        {
          "command": "novelpad.newCharacter",
          "when": "view == novelpad.entities",
          "group": "navigation@1"
        },
        {
          "command": "novelpad.exportTxt",
          "when": "view == novelpad.chapters",
          "group": "1_export@1"
        },
        {
          "command": "novelpad.exportDocx",
          "when": "view == novelpad.chapters",
          "group": "1_export@2"
        }
      ],
      "view/item/context": [
        {
          "command": "novelpad.newChapter",
          "when": "view == novelpad.chapters",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "novelpad.openChapter",
          "when": "false"
        },
        {
          "command": "novelpad.openEntity",
          "when": "false"
        },
        {
          "command": "novelpad.copilot.edit",
          "when": "false"
        },
        {
          "command": "novelpad._test.setApiKey",
          "when": "false"
        },
        {
          "command": "novelpad._test.continueAtCursor",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "NovelPad",
      "properties": {
        "novelpad.exportProfile": {
          "type": "string",
          "enum": [
            "default",
            "submission",
            "print"
          ],
          "default": "default",
          "description": "默认导出 profile（可被作品 .novelpad/config.json 覆盖）。"
        },
        "novelpad.lintOnSave": {
          "type": "boolean",
          "default": true,
          "description": "保存章节时运行 lint 并在问题面板显示。"
        },
        "novelpad.showWordCount": {
          "type": "boolean",
          "default": true,
          "description": "在状态栏显示当前章节字数与全书字数。"
        },
        "novelpad.copilot.enabled": {
          "type": "boolean",
          "default": true,
          "description": "启用 Novel Copilot（续写 / 润色 / 问答）。"
        },
        "novelpad.copilot.showReasoning": {
          "type": "boolean",
          "default": true,
          "description": "推理模型的思考过程（以小说家口吻写的批注）：续写完成后状态栏可点击查看，改写与问答面板折叠显示。"
        },
        "novelpad.copilot.provider": {
          "type": "string",
          "enum": ["custom", "deepseek", "zhipu", "dashscope", "ollama", "openai"],
          "enumDescriptions": [
            "自定义 / 本地反代（默认 127.0.0.1:8788/v1）",
            "DeepSeek 官方",
            "智谱 GLM",
            "通义千问 DashScope 兼容模式",
            "Ollama 本地（无需 Key）",
            "OpenAI 官方"
          ],
          "default": "custom",
          "description": "服务商预设（决定默认 baseUrl，可被 novelpad.copilot.baseUrl 覆盖）。"
        },
        "novelpad.copilot.baseUrl": {
          "type": "string",
          "default": "",
          "description": "OpenAI 兼容接口地址。留空则使用服务商预设。"
        },
        "novelpad.copilot.model": {
          "type": "string",
          "default": "deepseek-v4.1-flash",
          "description": "续写用模型。"
        },
        "novelpad.copilot.editModel": {
          "type": "string",
          "default": "",
          "description": "润色 / 扩写 / 问答用模型。留空则与续写相同。"
        },
        "novelpad.copilot.timeoutMs": {
          "type": "number",
          "default": 90000,
          "description": "请求超时（毫秒）。推理模型建议 ≥ 60000。"
        }
      }
    },
    "keybindings": [
      {
        "command": "novelpad.copilot.continueDirect",
        "key": "alt+\\",
        "mac": "alt+\\",
        "when": "editorLangId == markdown && editorTextFocus"
      },
      {
        "command": "novelpad.copilot.continue",
        "key": "alt+shift+\\",
        "mac": "alt+shift+\\",
        "when": "editorLangId == markdown && editorTextFocus"
      }
    ],
    "themes": [
      {
        "label": "宣纸 · NovelPad Paper",
        "uiTheme": "vs",
        "path": "./themes/novelpad-paper-color-theme.json"
      },
      {
        "label": "夜墨 · NovelPad Ink",
        "uiTheme": "vs-dark",
        "path": "./themes/novelpad-ink-color-theme.json"
      }
    ],
    "yaml.schemas": {
      "./schemas/character-v1.json": [
        "characters/*.yaml",
        "characters/*.yml"
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": ".novelpad/config.json",
        "url": "./schemas/project-config.schema.json"
      }
    ]
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "watch": "node ./scripts/build.mjs --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "package": "vsce package --no-dependencies",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@novelpad/core": "workspace:*",
    "marked": "^18.3.0"
  },
  "devDependencies": {
    "@types/marked": "^6.0.0",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^2.26.0",
    "esbuild": "^0.24.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
